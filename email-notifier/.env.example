# คัดลอกเป็น .env แล้วแก้ค่า (อย่า commit ไฟล์ .env)
PORT=3000

# Splunk management port (REST API)
SPLUNK_URL=https://splunk.company.local:8089
SPLUNK_APP=search
# แนะนำ: Splunk Authentication Token (Settings > Tokens)
SPLUNK_TOKEN=
# หรือใช้ username/password แทน token
SPLUNK_USER=
SPLUNK_PASS=
# ใบรับรอง CA ภายในของ Splunk (ถ้ามี) หรือ true เพื่อข้ามการตรวจสอบ (ไม่แนะนำ)
SPLUNK_CA_FILE=
SPLUNK_INSECURE_TLS=false

# ผู้ส่ง (ว่าง = ใช้ค่า default ของ Splunk ใน Settings > Server settings > Email settings)
MAIL_FROM=
# plain หรือ html
MAIL_CONTENT_TYPE=plain

# (ทางเลือก) โทเคนป้องกันคนอื่นเรียก API ของเครื่องมือนี้ — ใส่ค่าเดียวกันในหน้าเว็บ
API_TOKEN=
