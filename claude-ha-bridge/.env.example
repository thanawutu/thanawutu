# Copy to .env and fill in. Never commit the real .env file.

# Home Assistant base URL as seen from this Docker host (no trailing slash)
HA_URL=http://192.168.1.10:8123

# Long-lived access token (HA profile -> Security -> Long-lived access
# tokens). Use a DEDICATED Home Assistant user for this: this setup gives
# full REST API access (any entity, any service), not just entities
# exposed to Assist, so only hand Claude the account you're comfortable
# giving full control of.
HA_TOKEN=paste-your-home-assistant-token-here

# Random secret segment in the internal MCP URL. Never reaches the
# internet (Remote Control is outbound-only), but keeps other things on
# this Docker host from casually hitting the endpoint.
# Generate with: openssl rand -hex 24
MCP_PATH_SECRET=generate-a-long-random-string-here
