# Copy to .env and fill in. Never commit the real .env file.

# Your Home Assistant base URL as seen from the Docker host (no trailing slash)
HA_URL=http://192.168.1.10:8123

# Long-lived access token (HA profile -> Security -> Long-lived access tokens)
HA_TOKEN=paste-your-home-assistant-token-here

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel)
CF_TUNNEL_TOKEN=paste-your-cloudflared-tunnel-token-here

# Optional: your public hostname, only used by healthcheck.sh to also
# verify the Cloudflare Tunnel path (not read by docker-compose.yml)
TUNNEL_HOSTNAME=ha-x7k2q9.yourdomain.com
