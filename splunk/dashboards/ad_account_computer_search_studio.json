{
  "title": "AD Account & Computer Search",
  "description": "Search AD user accounts and computers (LDAP via SA-ldapsearch) and correlate with Windows Security events (Splunk_TA_windows). Click a row to drill down.",
  "inputs": {
    "input_acct": {
      "type": "input.text",
      "title": "Account (sAMAccountName / CN / mail)",
      "options": {
        "token": "acct",
        "defaultValue": "*"
      }
    },
    "input_comp": {
      "type": "input.text",
      "title": "Computer (name)",
      "options": {
        "token": "comp",
        "defaultValue": "*"
      }
    },
    "input_domain": {
      "type": "input.text",
      "title": "LDAP domain stanza",
      "options": {
        "token": "domain",
        "defaultValue": "default"
      }
    },
    "input_idx": {
      "type": "input.text",
      "title": "Windows index",
      "options": {
        "token": "idx",
        "defaultValue": "wineventlog"
      }
    },
    "input_stale": {
      "type": "input.dropdown",
      "title": "Stale (days)",
      "options": {
        "token": "stale",
        "defaultValue": "90",
        "items": [
          {
            "label": "30",
            "value": "30"
          },
          {
            "label": "60",
            "value": "60"
          },
          {
            "label": "90",
            "value": "90"
          },
          {
            "label": "180",
            "value": "180"
          }
        ]
      }
    },
    "input_spray": {
      "type": "input.dropdown",
      "title": "Spray threshold (accounts)",
      "options": {
        "token": "spray",
        "defaultValue": "10",
        "items": [
          {
            "label": "5",
            "value": "5"
          },
          {
            "label": "10",
            "value": "10"
          },
          {
            "label": "20",
            "value": "20"
          },
          {
            "label": "50",
            "value": "50"
          }
        ]
      }
    },
    "input_tr": {
      "type": "input.timerange",
      "title": "Event time range",
      "options": {
        "token": "tr",
        "defaultValue": "-24h@h,now"
      }
    }
  },
  "dataSources": {
    "ds_users": {
      "type": "ds.search",
      "name": "users",
      "options": {
        "query": "| ldapsearch domain=\"$domain$\"\n    search=\"(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2048))(|(sAMAccountName=$acct$)(cn=$acct$)(displayName=$acct$)(mail=$acct$)(userPrincipalName=$acct$)))\"\n    attrs=\"sAMAccountName,cn,objectSid,displayName,userPrincipalName,mail,title,department,manager,userAccountControl,lockoutTime,lastLogonTimestamp,pwdLastSet,whenCreated,memberOf,distinguishedName\"\n| eval lastLogon_e=strptime(lastLogonTimestamp,\"%Y-%m-%dT%H:%M:%S.%6NZ\"), pwd_e=strptime(pwdLastSet,\"%Y-%m-%dT%H:%M:%S.%6NZ\"), lock_e=strptime(lockoutTime,\"%Y-%m-%dT%H:%M:%S.%6NZ\"), created_e=strptime(whenCreated,\"%Y-%m-%d %H:%M:%S%:z\")\n| eval Status=case(isnotnull(mvfind(userAccountControl,\"ACCOUNTDISABLE\")),\"Disabled\", lock_e>0,\"Locked\", true(),\"Enabled\")\n| eval PwdNeverExpires=if(isnotnull(mvfind(userAccountControl,\"DONT_EXPIRE_PASSWD\")),\"Yes\",\"No\")\n| eval PwdNotRequired=if(isnotnull(mvfind(userAccountControl,\"PASSWD_NOTREQD\")),\"Yes\",\"No\")\n| eval DaysSinceLogon=if(lastLogon_e>0,round((now()-lastLogon_e)/86400,0),\"never\")\n| eval PwdAgeDays=case(pwd_e>0,round((now()-pwd_e)/86400,0), pwdLastSet=\"(never)\",\"must change\", true(),\"-\")\n| eval Created=strftime(created_e,\"%Y-%m-%d\"), Manager=replace(mvindex(split(manager,\",\"),0),\"^CN=\",\"\"), Groups=coalesce(mvcount(memberOf),0), OU=replace(distinguishedName,\"^.*?,(?=(OU|CN|DC)=)\",\"\")",
        "queryParameters": {
          "earliest": "0",
          "latest": "now"
        }
      }
    },
    "ds_computers": {
      "type": "ds.search",
      "name": "computers",
      "options": {
        "query": "| ldapsearch domain=\"$domain$\"\n    search=\"(&(objectClass=computer)(|(name=$comp$)(dNSHostName=$comp$)))\"\n    attrs=\"name,dNSHostName,operatingSystem,operatingSystemVersion,description,managedBy,userAccountControl,lastLogonTimestamp,whenCreated,distinguishedName\"\n| eval lastLogon_e=strptime(lastLogonTimestamp,\"%Y-%m-%dT%H:%M:%S.%6NZ\"), created_e=strptime(whenCreated,\"%Y-%m-%d %H:%M:%S%:z\")\n| eval Status=if(isnotnull(mvfind(userAccountControl,\"ACCOUNTDISABLE\")),\"Disabled\",\"Enabled\")\n| eval Role=case(isnotnull(mvfind(userAccountControl,\"SERVER_TRUST_ACCOUNT\")),\"Domain Controller\", isnotnull(mvfind(userAccountControl,\"PARTIAL_SECRETS_ACCOUNT\")),\"RODC\", match(operatingSystem,\"(?i)server\"),\"Server\", isnull(operatingSystem),\"Unknown\", true(),\"Workstation\")\n| eval DaysSinceLogon=if(lastLogon_e>0,round((now()-lastLogon_e)/86400,0),\"never\")\n| eval Created=strftime(created_e,\"%Y-%m-%d\"), ManagedBy=replace(mvindex(split(managedBy,\",\"),0),\"^CN=\",\"\"), OU=replace(distinguishedName,\"^.*?,(?=(OU|CN|DC)=)\",\"\")\n| fillnull value=\"-\" operatingSystem operatingSystemVersion ManagedBy",
        "queryParameters": {
          "earliest": "0",
          "latest": "now"
        }
      }
    },
    "ds_auth": {
      "type": "ds.search",
      "name": "auth",
      "options": {
        "query": "| tstats summariesonly=true count from datamodel=Authentication\n    where nodename=Authentication sourcetype=\"WinEventLog\" (Authentication.signature_id=4624 OR Authentication.signature_id=4625)\n      Authentication.user=\"*$acct$\" (Authentication.dest=\"$comp$\" OR Authentication.dest=\"$comp$.*\")\n    by _time span=1h Authentication.user Authentication.dest Authentication.src Authentication.action\n| rename Authentication.* AS *\n| eval user=lower(mvindex(split(mvindex(split(user,\"@\"),0),\"\\\\\"),-1))\n| search user=\"$acct$\"\n| where NOT like(user,\"%$$\") AND user!=\"-\" AND lower(user)!=\"anonymous logon\" AND user!=\"unknown\"\n| eval dest_short=upper(mvindex(split(dest,\".\"),0)), Result=if(action=\"success\",\"Success\",\"Failure\")\n| stats sum(count) AS count by _time user dest_short src Result"
      }
    },
    "ds_kerb": {
      "type": "ds.search",
      "name": "kerb",
      "options": {
        "query": "index=\"$idx$\" source=\"WinEventLog:Security\" (EventCode=4771 OR EventCode=4776) user=\"$acct$\"\n| eval code=lower(coalesce(Sub_Status,Failure_Code,Error_Code,\"-\")), Reason=case(EventCode=4624 OR EventCode=4740,\"-\",code=\"0xc000006a\" OR code=\"0x18\",\"Bad password\",code=\"0xc0000064\" OR code=\"0x6\",\"Unknown user\",code=\"0xc0000234\",\"Locked out\",code=\"0xc0000072\" OR code=\"0x12\",\"Disabled/locked\",code=\"0xc0000071\" OR code=\"0x17\",\"Password expired\",code=\"0xc0000193\",\"Account expired\",code=\"0xc0000224\",\"Must change password\",code=\"0xc000006f\",\"Outside logon hours\",code=\"0xc0000070\",\"Workstation restricted\",true(),code)\n| where EventCode=4771 OR (code!=\"0x0\" AND code!=\"-\")\n| where NOT like(user,\"%$$\") AND user!=\"-\" AND lower(user)!=\"anonymous logon\"\n| eval user=lower(user), src=coalesce(src,Source_Network_Address,Workstation_Name,\"-\"), Protocol=if(EventCode=4771,\"Kerberos\",\"NTLM\"), DC=upper(mvindex(split(host,\".\"),0))\n| bin _time span=1h\n| stats count by _time user src DC Protocol Reason"
      }
    },
    "ds_lockouts": {
      "type": "ds.search",
      "name": "lockouts",
      "options": {
        "query": "index=\"$idx$\" source=\"WinEventLog:Security\" EventCode=4740 user=\"$acct$\"\n| eval k=user.\"|\".floor(_time/60)\n| stats dc(k) AS count"
      }
    },
    "ds_dc_cov": {
      "type": "ds.search",
      "name": "dc_cov",
      "options": {
        "query": "| ldapsearch domain=\"$domain$\" search=\"(&(objectClass=computer)(userAccountControl:1.2.840.113556.1.4.803:=8192))\" attrs=\"name,operatingSystem\"\n| eval host=upper(name)\n| join type=left host\n    [| tstats count latest(_time) AS last where index=\"$idx$\" source=\"WinEventLog:Security\" earliest=-24h by host\n     | eval host=upper(mvindex(split(host,\".\"),0)) | stats sum(count) AS count max(last) AS last by host]\n| eval Status=if(coalesce(count,0)>0,\"Logging\",\"NOT LOGGING\"), Events24h=coalesce(count,0), LastEvent=if(isnull(last),\"-\",strftime(last,\"%Y-%m-%d %H:%M\"))\n| table name operatingSystem Status Events24h LastEvent\n| sort -Status name",
        "queryParameters": {
          "earliest": "0",
          "latest": "now"
        }
      }
    },
    "ds_k_users": {
      "type": "ds.chain",
      "name": "k_users",
      "options": {
        "extend": "ds_users",
        "query": "| stats count"
      }
    },
    "ds_k_dislock": {
      "type": "ds.chain",
      "name": "k_dislock",
      "options": {
        "extend": "ds_users",
        "query": "| where Status!=\"Enabled\" | stats count"
      }
    },
    "ds_k_notreqd": {
      "type": "ds.chain",
      "name": "k_notreqd",
      "options": {
        "extend": "ds_users",
        "query": "| where PwdNotRequired=\"Yes\" AND Status!=\"Disabled\" | stats count"
      }
    },
    "ds_k_comps": {
      "type": "ds.chain",
      "name": "k_comps",
      "options": {
        "extend": "ds_computers",
        "query": "| stats count"
      }
    },
    "ds_k_fail": {
      "type": "ds.chain",
      "name": "k_fail",
      "options": {
        "extend": "ds_auth",
        "query": "| where Result=\"Failure\" | stats sum(count) AS count | fillnull value=0 count"
      }
    },
    "ds_k_krb": {
      "type": "ds.chain",
      "name": "k_krb",
      "options": {
        "extend": "ds_kerb",
        "query": "| stats sum(count) AS count | fillnull value=0 count"
      }
    },
    "ds_k_lock": {
      "type": "ds.chain",
      "name": "k_lock",
      "options": {
        "extend": "ds_lockouts",
        "query": "| table count"
      }
    },
    "ds_k_dcmiss": {
      "type": "ds.chain",
      "name": "k_dcmiss",
      "options": {
        "extend": "ds_dc_cov",
        "query": "| where Status=\"NOT LOGGING\" | stats count"
      }
    },
    "ds_t_users": {
      "type": "ds.chain",
      "name": "t_users",
      "options": {
        "extend": "ds_users",
        "query": "| table sAMAccountName cn displayName mail title department Manager Status PwdNotRequired PwdNeverExpires DaysSinceLogon PwdAgeDays Groups Created OU objectSid | sort sAMAccountName"
      }
    },
    "ds_t_groups": {
      "type": "ds.chain",
      "name": "t_groups",
      "options": {
        "extend": "ds_users",
        "query": "| search sAMAccountName=\"$sel_user$\" | fields memberOf | mvexpand memberOf\n| eval Group=replace(mvindex(split(memberOf,\",\"),0),\"^CN=\",\"\"), Privileged=if(match(Group,\"(?i)^(Domain Admins|Enterprise Admins|Schema Admins|Administrators|Account Operators|Backup Operators|Server Operators|Print Operators|DnsAdmins|Group Policy Creator Owners|Enterprise Key Admins|Key Admins)$\"),\"YES\",\"-\")\n| table Group Privileged | sort -Privileged Group"
      }
    },
    "ds_t_used": {
      "type": "ds.search",
      "name": "t_used",
      "options": {
        "query": "index=\"$idx$\" source=\"WinEventLog:Security\" EventCode=4624 user=\"$sel_user$\"\n| eval dest_short=upper(mvindex(split(dest,\".\"),0)), src=coalesce(src,Source_Network_Address,Workstation_Name,\"-\")\n| eval LogonType=case(Logon_Type=2,\"2 Interactive\",Logon_Type=3,\"3 Network\",Logon_Type=4,\"4 Batch\",Logon_Type=5,\"5 Service\",Logon_Type=7,\"7 Unlock\",Logon_Type=8,\"8 NetworkCleartext\",Logon_Type=9,\"9 NewCredentials\",Logon_Type=10,\"10 RemoteInteractive\",Logon_Type=11,\"11 CachedInteractive\",isnotnull(Logon_Type),tostring(Logon_Type),true(),\"-\")\n| stats count AS Logons values(LogonType) AS LogonTypes dc(src) AS Sources max(_time) AS Last by dest_short\n| eval Last=strftime(Last,\"%Y-%m-%d %H:%M\") | rename dest_short AS Computer | sort -Logons"
      }
    },
    "ds_c_timeline": {
      "type": "ds.chain",
      "name": "c_timeline",
      "options": {
        "extend": "ds_auth",
        "query": "| search user=\"$sel_user$\" | timechart span=1h sum(count) AS count by Result"
      }
    },
    "ds_t_changes": {
      "type": "ds.search",
      "name": "t_changes",
      "options": {
        "query": "index=\"$idx$\" source=\"WinEventLog:Security\" EventCode IN (4720,4722,4723,4724,4725,4726,4738,4740,4767,4728,4729,4732,4733,4756,4757)\n| eval target=lower(coalesce(user,mvindex(Account_Name,-1))), member_sid=if(mvcount(Security_ID)>=3,mvindex(Security_ID,1),\"-\")\n| where target=lower(\"$sel_user$\") OR target=lower(\"$sel_cn$\") OR member_sid=\"$sel_sid$\"\n| eval Action=case(EventCode=4720,\"Created\",EventCode=4722,\"Enabled\",EventCode=4723,\"Password change\",EventCode=4724,\"Password reset\",EventCode=4725,\"Disabled\",EventCode=4726,\"Deleted\",EventCode=4738,\"Changed\",EventCode=4740,\"Locked out\",EventCode=4767,\"Unlocked\",EventCode=4728 OR EventCode=4732 OR EventCode=4756,\"Added to group\",EventCode=4729 OR EventCode=4733 OR EventCode=4757,\"Removed from group\")\n| eval By=coalesce(src_user,mvindex(Account_Name,0)), Group=coalesce(Group_Name,\"-\"), Caller=coalesce(Caller_Computer_Name,\"-\"), DC=upper(mvindex(split(host,\".\"),0)), Time=strftime(_time,\"%Y-%m-%d %H:%M:%S\")\n| table Time Action By Group Caller DC EventCode | sort -Time | head 200"
      }
    },
    "ds_t_comps": {
      "type": "ds.chain",
      "name": "t_comps",
      "options": {
        "extend": "ds_computers",
        "query": "| table name dNSHostName Role operatingSystem operatingSystemVersion Status DaysSinceLogon ManagedBy Created OU | sort name"
      }
    },
    "ds_c_os": {
      "type": "ds.chain",
      "name": "c_os",
      "options": {
        "extend": "ds_computers",
        "query": "| stats count by operatingSystem | sort -count"
      }
    },
    "ds_t_logged": {
      "type": "ds.search",
      "name": "t_logged",
      "options": {
        "query": "index=\"$idx$\" source=\"WinEventLog:Security\" EventCode IN (4624,4625) (dest=\"$sel_comp$\" OR dest=\"$sel_comp$.*\")\n| where NOT like(user,\"%$$\") AND user!=\"-\" AND lower(user)!=\"anonymous logon\"\n| eval user=lower(user), src=coalesce(src,Source_Network_Address,Workstation_Name,\"-\")\n| eval LogonType=case(Logon_Type=2,\"2 Interactive\",Logon_Type=3,\"3 Network\",Logon_Type=4,\"4 Batch\",Logon_Type=5,\"5 Service\",Logon_Type=7,\"7 Unlock\",Logon_Type=8,\"8 NetworkCleartext\",Logon_Type=9,\"9 NewCredentials\",Logon_Type=10,\"10 RemoteInteractive\",Logon_Type=11,\"11 CachedInteractive\",isnotnull(Logon_Type),tostring(Logon_Type),true(),\"-\")\n| stats count(eval(EventCode=4624)) AS Success count(eval(EventCode=4625)) AS Failure values(LogonType) AS LogonTypes dc(src) AS Sources max(_time) AS Last by user\n| eval Last=strftime(Last,\"%Y-%m-%d %H:%M\") | sort -Success"
      }
    },
    "ds_t_compchg": {
      "type": "ds.search",
      "name": "t_compchg",
      "options": {
        "query": "index=\"$idx$\" source=\"WinEventLog:Security\" EventCode IN (4741,4742,4743) user=\"$sel_comp$*\"\n| where upper(replace(user,\"[^A-Za-z0-9._-]\",\"\"))=upper(\"$sel_comp$\")\n| eval Action=case(EventCode=4741,\"Created\",EventCode=4742,\"Changed\",EventCode=4743,\"Deleted\"), By=coalesce(src_user,mvindex(Account_Name,0)), DC=upper(mvindex(split(host,\".\"),0)), Time=strftime(_time,\"%Y-%m-%d %H:%M:%S\")\n| table Time Action By DC EventCode | sort -Time | head 200"
      }
    },
    "ds_t_stale_u": {
      "type": "ds.chain",
      "name": "t_stale_u",
      "options": {
        "extend": "ds_users",
        "query": "| where Status=\"Enabled\" AND (DaysSinceLogon=\"never\" OR tonumber(DaysSinceLogon)>$stale$) | table sAMAccountName displayName department DaysSinceLogon PwdAgeDays PwdNeverExpires OU | sort -DaysSinceLogon"
      }
    },
    "ds_t_stale_c": {
      "type": "ds.chain",
      "name": "t_stale_c",
      "options": {
        "extend": "ds_computers",
        "query": "| where Status=\"Enabled\" AND (DaysSinceLogon=\"never\" OR tonumber(DaysSinceLogon)>$stale$) | table name Role operatingSystem DaysSinceLogon OU | sort -DaysSinceLogon"
      }
    },
    "ds_t_topfail": {
      "type": "ds.chain",
      "name": "t_topfail",
      "options": {
        "extend": "ds_auth",
        "query": "| where Result=\"Failure\" | stats sum(count) AS Failures dc(dest_short) AS Targets dc(src) AS Sources by user | sort -Failures | head 20"
      }
    },
    "ds_t_spray": {
      "type": "ds.chain",
      "name": "t_spray",
      "options": {
        "extend": "ds_auth",
        "query": "| where Result=\"Failure\" AND src!=\"unknown\" | stats sum(count) AS Failures dc(user) AS Accounts dc(dest_short) AS Targets by src | where Accounts>=$spray$ | sort -Accounts | head 20"
      }
    },
    "ds_t_krbuser": {
      "type": "ds.chain",
      "name": "t_krbuser",
      "options": {
        "extend": "ds_kerb",
        "query": "| stats sum(count) AS Failures dc(src) AS Sources values(Protocol) AS Protocol values(Reason) AS Reasons by user | sort -Failures | head 20"
      }
    },
    "ds_t_krbspray": {
      "type": "ds.chain",
      "name": "t_krbspray",
      "options": {
        "extend": "ds_kerb",
        "query": "| stats sum(count) AS Failures dc(user) AS Accounts values(Protocol) AS Protocol values(Reason) AS Reasons by src | where Accounts>=$spray$ | sort -Accounts | head 20"
      }
    },
    "ds_t_lockcaller": {
      "type": "ds.search",
      "name": "t_lockcaller",
      "options": {
        "query": "index=\"$idx$\" source=\"WinEventLog:Security\" EventCode=4740 user=\"$acct$\"\n| eval Caller=upper(coalesce(Caller_Computer_Name,\"-\")), k=user.\"|\".floor(_time/60)\n| stats dc(k) AS Lockouts dc(user) AS Accounts values(user) AS Users max(_time) AS Last by Caller\n| eval Users=mvjoin(mvindex(Users,0,4),\", \"), Last=strftime(Last,\"%Y-%m-%d %H:%M\") | sort -Lockouts | head 20"
      }
    },
    "ds_t_localgrp": {
      "type": "ds.search",
      "name": "t_localgrp",
      "options": {
        "query": "index=\"$idx$\" source=\"WinEventLog:Security\" EventCode IN (4732,4733) (host=\"$comp$\" OR host=\"$comp$.*\")\n| eval member_sid=if(mvcount(Security_ID)>=3,mvindex(Security_ID,1),mvindex(Security_ID,-1))\n| fields _time host EventCode Group_Name src_user Account_Name member_sid\n| append [| ldapsearch domain=\"$domain$\" search=\"(objectClass=domain)\" attrs=\"objectSid\" | rename objectSid AS domain_sid | fields domain_sid]\n| eventstats values(domain_sid) AS domain_sid\n| where isnotnull(EventCode)\n| eval Action=if(EventCode=4732,\"Added\",\"Removed\"), Server=upper(mvindex(split(host,\".\"),0)), Group=coalesce(Group_Name,\"-\"),\n       By=coalesce(src_user,mvindex(Account_Name,0)), Time=strftime(_time,\"%Y-%m-%d %H:%M:%S\"),\n       MemberType=case(match(member_sid,\"^S-1-5-21-\") AND replace(member_sid,\"-\\d+$$\",\"\")=domain_sid,\"Domain account\",\n                       match(member_sid,\"^S-1-5-21-\"),\"Local / other domain\", match(member_sid,\"^S-1-5-32-\"),\"Builtin group\",\n                       match(member_sid,\"^S-1-5-\"),\"Well-known\", true(),\"Resolved name\"),\n       Privileged=if(match(Group,\"(?i)^(Administrators|Remote Desktop Users|Backup Operators|Remote Management Users|Hyper-V Administrators|Event Log Readers)$$\"),\"YES\",\"-\")\n| table Time Server Action Group Privileged MemberType member_sid By\n| sort -Time | head 500"
      }
    },
    "ds_t_risky": {
      "type": "ds.chain",
      "name": "t_risky",
      "options": {
        "extend": "ds_users",
        "query": "| where Status!=\"Disabled\" AND (PwdNotRequired=\"Yes\" OR PwdNeverExpires=\"Yes\") | table sAMAccountName displayName department Status PwdNotRequired PwdNeverExpires PwdAgeDays DaysSinceLogon OU | sort -PwdNotRequired sAMAccountName"
      }
    }
  },
  "visualizations": {
    "md_head": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "Validated SPL · LDAP (SA-ldapsearch) + WinEventLog:Security · **click a row** to drill down",
        "fontColor": "#C5CCD3"
      }
    },
    "viz_k_users": {
      "type": "splunk.singlevalue",
      "title": "Accounts",
      "dataSources": {
        "primary": "ds_k_users"
      },
      "options": {}
    },
    "viz_k_dislock": {
      "type": "splunk.singlevalue",
      "title": "Disabled / Locked",
      "dataSources": {
        "primary": "ds_k_dislock"
      },
      "options": {
        "backgroundColor": "> majorValue | rangeValue(bgCfg)",
        "majorColor": "#FFFFFF"
      },
      "context": {
        "bgCfg": [
          {
            "to": 1,
            "value": "#53A051"
          },
          {
            "from": 1,
            "to": 50,
            "value": "#F8BE34"
          },
          {
            "from": 50,
            "value": "#DC4E41"
          }
        ]
      }
    },
    "viz_k_notreqd": {
      "type": "splunk.singlevalue",
      "title": "PASSWD_NOTREQD (enabled)",
      "dataSources": {
        "primary": "ds_k_notreqd"
      },
      "options": {
        "backgroundColor": "> majorValue | rangeValue(bgCfg)",
        "majorColor": "#FFFFFF"
      },
      "context": {
        "bgCfg": [
          {
            "to": 1,
            "value": "#53A051"
          },
          {
            "from": 1,
            "value": "#DC4E41"
          }
        ]
      }
    },
    "viz_k_comps": {
      "type": "splunk.singlevalue",
      "title": "Computers",
      "dataSources": {
        "primary": "ds_k_comps"
      },
      "options": {}
    },
    "viz_k_fail": {
      "type": "splunk.singlevalue",
      "title": "Failed logons (4625)",
      "dataSources": {
        "primary": "ds_k_fail"
      },
      "options": {
        "backgroundColor": "> majorValue | rangeValue(bgCfg)",
        "majorColor": "#FFFFFF"
      },
      "context": {
        "bgCfg": [
          {
            "to": 100,
            "value": "#53A051"
          },
          {
            "from": 100,
            "to": 1000,
            "value": "#F8BE34"
          },
          {
            "from": 1000,
            "value": "#DC4E41"
