[collections/r7_scan_jobs]
access = read : [ * ], write : [ admin, sc_admin, rapid7_cve_rescan ]

[collections/r7_cmdb_changes]
access = read : [ * ], write : [ admin, sc_admin ]

[collections/r7_cmdb_prev]
access = read : [ * ], write : [ admin, sc_admin ]

[savedsearches]
owner = nobody

[collections/r7_asset_actions]
access = read : [ * ], write : [ admin, sc_admin, rapid7_cve_analyst, rapid7_cve_rescan, rapid7_cve_asset_admin ]

