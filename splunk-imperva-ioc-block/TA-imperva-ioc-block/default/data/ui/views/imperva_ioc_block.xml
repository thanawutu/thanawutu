<form version="1.1" theme="dark" hideFilters="true" script="imperva_cells.js">
  <label>Imperva IOC Block – last 7 days</label>
  <description>IPs detected by the WAF detection rules in the last 7 days that are not blocked yet. Click rows to select IPs, fill Ticket / Incident no. and Description, then click ⛔ BLOCK (one click, no second confirm). Older detections, Blocked IPs / Unblock, Detection rules and the Audit log are on the other pages.</description>
  <init>
    <set token="d_sel">,</set>
    <set token="d_refresh">init</set>
  </init>

  <row>
    <panel>
      <html>
        <div><a href="imperva_ioc_block" style="display:inline-block;padding:6px 14px;border:1px solid #3c444d;border-radius:4px;text-decoration:none;font-weight:600;margin:0 6px 4px 0;background:#1F6F8B;color:#fff;border-color:#1F6F8B">⛔ Block – last 7 days</a>
        <a href="imperva_ioc_history" style="display:inline-block;padding:6px 14px;border:1px solid #3c444d;border-radius:4px;text-decoration:none;font-weight:600;margin:0 6px 4px 0;color:#c3cbd4">🗂 Older detections</a>
        <a href="imperva_ioc_blocked" style="display:inline-block;padding:6px 14px;border:1px solid #3c444d;border-radius:4px;text-decoration:none;font-weight:600;margin:0 6px 4px 0;color:#c3cbd4">🔓 Blocked IPs / Unblock</a>
        <a href="imperva_ioc_rules" style="display:inline-block;padding:6px 14px;border:1px solid #3c444d;border-radius:4px;text-decoration:none;font-weight:600;margin:0 6px 4px 0;color:#c3cbd4">⚙ Detection rules</a>
        <a href="imperva_ioc_audit" style="display:inline-block;padding:6px 14px;border:1px solid #3c444d;border-radius:4px;text-decoration:none;font-weight:600;margin:0 6px 4px 0;color:#c3cbd4">📄 Audit log</a></div>
      </html>
    </panel>
  </row>

  <!-- detected IPs, last 7 days, not blocked from Splunk yet (re-read after every block) -->
  <search id="det">
    <query>`imperva_ioc_detections`
| eval _r=$d_refresh|s$</query>
    <earliest>-7d</earliest>
    <latest>now</latest>
    <refresh>300s</refresh>
    <refreshType>delay</refreshType>
  </search>
  <!-- from the KV store registry (no SOAR call); the live WAF list is on the Blocked IPs page -->
  <search id="waf_now">
    <query>| inputlookup imperva_block_registry where status="blocked"
| eval _r=$d_refresh|s$
| stats dc(ip) AS blocked_on_waf</query>
    <earliest>-1m</earliest>
    <latest>now</latest>
    <refresh>300s</refresh>
    <refreshType>delay</refreshType>
  </search>
  <search id="audit7">
    <query>| `imperva_audit_daily(7)`
| eval _r=$d_refresh|s$</query>
    <earliest>-1m</earliest>
    <latest>now</latest>
    <refresh>300s</refresh>
    <refreshType>delay</refreshType>
  </search>

  <row>
    <panel>
      <single>
        <title>Detected WAF IPs</title>
        <search base="det">
          <query>| stats count AS detected</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0xF8BE34","0xF8BE34"]</option>
        <option name="useColors">1</option>
        <option name="underLabel">last 7 days, not blocked yet</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Blocked on WAF (from Splunk)</title>
        <search base="waf_now">
          <query>| fields blocked_on_waf</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x5A9BD5","0x5A9BD5"]</option>
        <option name="useColors">1</option>
        <option name="underLabel">registry - live list on Blocked IPs page</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Blocked today</title>
        <search base="audit7">
          <query>| fields _time "Blocked IPs"</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0xDC4E41","0xDC4E41"]</option>
        <option name="useColors">1</option>
        <option name="underLabel">vs yesterday</option>
        <option name="showTrendIndicator">1</option>
        <option name="trendDisplayMode">absolute</option>
        <option name="showSparkline">0</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Blocked 7 days</title>
        <search base="audit7">
          <query>| stats sum("Blocked IPs") AS blocked</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0xDC4E41","0xDC4E41"]</option>
        <option name="useColors">1</option>
        <option name="underLabel">unique IPs per day, summed</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Unblocked 7 days</title>
        <search base="audit7">
          <query>| stats sum("Unblocked IPs") AS unblocked</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53A051","0x53A051"]</option>
        <option name="useColors">1</option>
        <option name="underLabel">from the audit log</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Blocked / unblocked IPs per day – last 7 days (30 days: Older detections page)</title>
      <chart>
        <search base="audit7">
          <query>| fields _time "Blocked IPs" "Unblocked IPs"</query>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.chart.showDataLabels">all</option>
        <option name="charting.axisTitleX.visibility">collapsed</option>
        <option name="charting.axisTitleY.text">IPs</option>
        <option name="charting.axisLabelsX.majorLabelStyle.rotation">0</option>
        <option name="charting.fieldColors">{"Blocked IPs":0xDC4E41,"Unblocked IPs":0x53A051}</option>
        <option name="charting.legend.placement">top</option>
        <option name="height">240</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Search and Block</title>
      <input type="text" token="d_q" searchWhenChanged="true">
        <label>🔎 Search IP / Ticket / Incident no. / Rule (* = all)</label>
        <default>*</default>
      </input>
      <input type="text" token="d_add" searchWhenChanged="true">
        <label>Add IPs manually – other sources, comma separated ("-" if none)</label>
        <default>-</default>
      </input>
      <input type="text" token="d_tk" searchWhenChanged="true">
        <label>Ticket / Incident no. ("-" if none)</label>
        <default>-</default>
      </input>
      <input type="text" token="d_desc" searchWhenChanged="true">
        <label>Description ("-" if none)</label>
        <default>-</default>
      </input>
      <table>
        <search base="det">
          <query>| eval _q=lower(trim(replace($d_q|s$, "[*]", "")))
| where _q="" OR like(lower(src." ".incident_no." ".rule_name), "%"._q."%")
| sort - _sev_rank - count
| head 50
| stats count AS shown_n values(src) AS shown
| eval SelectAll=if(shown_n>0, "☑ Select all ".shown_n." shown: ".mvjoin(shown, ","), "-")
| eval ip=split("-,".replace(trim($d_sel|s$, ","), "☑ Select all \d+ shown: ", ""), ",")
| mvexpand ip
| eventstats count AS _c BY ip
| eval ip=if(ip!="" AND ip!="-" AND _c%2=1, ip, null())
| stats first(SelectAll) AS SelectAll values(ip) AS ip
| eval ips=coalesce(mvjoin(ip, ","), ""), n=if(ips="", 0, coalesce(mvcount(split(ips, ",")), 0))
| eval nb_ips=ips, nb_n=n
| eval _add=trim(replace($d_add|s$, "[\s;]+", ","), ","), _add=if(_add="-", "", _add)
| eval ips=trim(coalesce(ips, "").",".replace(_add, ",+", ","), ","), ips=coalesce(mvjoin(mvdedup(split(ips, ",")), ","), "")
| eval ips=if(ips=",", "", ips), n=if(ips="", 0, coalesce(mvcount(split(ips, ",")), 0))
| eval ip=if(n=0, "-", split(ips, ","))
| mvexpand ip
| impervapolicycheck field=ip
| lookup imperva_block_registry ip OUTPUT status AS _reg
| eval chk=case(ip="-" OR ip="", null(),
    NOT (match(ip, "^\d{1,3}(\.\d{1,3}){3}(/\d{1,2})?\z") OR (match(ip, ":") AND match(ip, "^[0-9A-Fa-f:.]+(/\d{1,3})?\z"))), ip." is not an IP / CIDR",
    isnotnull(mvfind(_reg, "^blocked\z")), ip." already blocked from Splunk",
    waf_policy_verdict="ALLOWLISTED", ip." is ALLOWED: ".waf_policies,
    waf_policy_verdict="BLOCKED_ELSEWHERE" OR waf_policy_verdict="BLOCKED_HERE", ip." already BLOCKED: ".waf_policies,
    waf_policy_verdict="UNKNOWN", ip." WAF check unavailable",
    true(), null())
| stats first(SelectAll) AS SelectAll first(ips) AS ips first(n) AS n first(nb_ips) AS nb_ips first(nb_n) AS nb_n values(chk) AS waf_check
| eval ips=coalesce(ips, ""), n=coalesce(n, 0), nb_ips=coalesce(nb_ips, ""), nb_n=coalesce(nb_n, 0)
| eval waf_check=coalesce(mvjoin(waf_check, " | "), if(n=0, "-", "✔ none blocked / allowed on WAF"))
| eval nb_n=coalesce(nb_n, 0), NotBlock=if(nb_n>0, "✖ NOT BLOCK ".nb_n." IP".if(nb_n=1, "", "s").": ".replace(nb_ips, ",", ", "), "-")
| eval Action=if(n=0, "Click rows below or add IPs manually", "⛔ BLOCK ".n." IP".if(n=1, "", "s")), Clear=if(n=0, "-", "✖ Clear selection")
| eval selected_ips=if(n=0, "-", replace(ips, ",", ", ")), ticket=$d_tk|s$, description=$d_desc|s$
| eval ticket=if(ticket="-" AND match($d_q|s$, "(?i)^\s*ITHM"), upper(trim($d_q|s$)), ticket)
| table Action NotBlock Clear SelectAll selected_ips waf_check ticket description</query>
        </search>
        <option name="count">1</option>
        <option name="wrap">true</option>
        <option name="drilldown">cell</option>
        <format type="color" field="Action">
          <colorPalette type="expression">if(like(value, "⛔%"), "#DC4E41", "#3C444D")</colorPalette>
        </format>
        <format type="color" field="NotBlock">
          <colorPalette type="expression">if(like(value, "✖%"), "#5C6773", "#3C444D")</colorPalette>
        </format>
        <format type="color" field="SelectAll">
          <colorPalette type="expression">if(like(value, "☑%"), "#1F6F8B", "#3C444D")</colorPalette>
        </format>
        <format type="color" field="waf_check">
          <colorPalette type="expression">if(like(value, "✔%") OR value=="-", "#3C444D", "#B26B00")</colorPalette>
        </format>
        <drilldown>
          <!-- one click = do it (no second confirm) -->
          <condition field="Action">
            <set token="d_exec_ips">$row.selected_ips$</set>
            <set token="d_exec_tk">$row.ticket$</set>
            <set token="d_exec_desc">$row.description$</set>
            <set token="d_sel">,</set>
            <set token="form.d_tk">-</set>
            <set token="form.d_desc">-</set>
            <set token="form.d_add">-</set>
          </condition>
          <condition field="NotBlock">
            <set token="d_nb_exec">$click.value2$</set>
            <set token="d_nb_tk">$row.ticket$</set>
            <set token="d_nb_desc">$row.description$</set>
            <set token="d_sel">,</set>
            <set token="form.d_tk">-</set>
            <set token="form.d_desc">-</set>
          </condition>
          <condition field="SelectAll">
            <!-- replaces the selection with every IP that matches the search box -->
            <set token="d_sel">,$click.value2$,</set>
          </condition>
          <condition field="Clear">
            <set token="d_sel">,</set>
            <set token="form.d_add">-</set>
          </condition>
          <condition></condition>
        </drilldown>
      </table>
    </panel>
  </row>

  <row>
    <panel depends="$d_exec_ips$">
      <title>Block result – written to the audit log (click a row to close)</title>
      <table>
        <search>
          <query>| makeresults
| impervablock action=block ip=$d_exec_ips|s$ incident_no=$d_exec_tk|s$ description=$d_exec_desc|s$
| `imperva_audit_write`
| table time ip action status verified ticket description backend soar_container detail</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
          <done>
            <set token="d_refresh">$job.sid$</set>
          </done>
        </search>
        <option name="count">50</option>
        <option name="wrap">true</option>
        <option name="drilldown">cell</option>
        <format type="color" field="status">
          <colorPalette type="map">{"blocked":#DC4E41,"unblocked":#53A051,"no_change":#708794,"rejected":#AF575A,"error":#B6488E,"dismissed":#5C6773,"restored":#5A9BD5}</colorPalette>
        </format>
        <format type="color" field="verified">
          <colorPalette type="map">{"yes":#53A051,"no":#DC4E41,"unknown":#F8BE34}</colorPalette>
        </format>
        <drilldown>
          <unset token="d_exec_ips"></unset>
        </drilldown>
      </table>
    </panel>
  </row>

  <row>
    <panel depends="$d_nb_exec$">
      <title>Not block result – hidden until detected again, nothing sent to the WAF (click a row to close)</title>
      <table>
        <search>
          <query>| impervadismiss action=add ip=$d_nb_exec|s$ incident_no=$d_nb_tk|s$ description=$d_nb_desc|s$
| `imperva_audit_write`
| table time ip action status ticket description detail</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
          <done>
            <set token="d_refresh">$job.sid$</set>
          </done>
        </search>
        <option name="count">50</option>
        <option name="wrap">true</option>
        <option name="drilldown">cell</option>
        <format type="color" field="status">
          <colorPalette type="map">{"blocked":#DC4E41,"unblocked":#53A051,"no_change":#708794,"rejected":#AF575A,"error":#B6488E,"dismissed":#5C6773,"restored":#5A9BD5}</colorPalette>
        </format>
        <format type="color" field="verified">
          <colorPalette type="map">{"yes":#53A051,"no":#DC4E41,"unknown":#F8BE34}</colorPalette>
        </format>
        <drilldown>
          <unset token="d_nb_exec"></unset>
        </drilldown>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>IPs detected by WAF rules – last 7 days (click a row to select / unselect it)</title>
      <table id="det_table">
        <search base="det">
          <query>| eval _q=lower(trim(replace($d_q|s$, "[*]", "")))
| where _q="" OR like(lower(src." ".incident_no." ".rule_name), "%"._q."%")
| `imperva_ioc_enrich`</query>
        </search>
        <option name="count">20</option>
        <option name="wrap">true</option>
        <option name="drilldown">cell</option>
        <format type="color" field="VirusTotal">
          <colorPalette type="expression">"#2C62B3"</colorPalette>
        </format>
        <format type="color" field="suggestion">
          <colorPalette type="map">{"BLOCK":#DC4E41,"REVIEW":#F8BE34,"MONITOR":#5A9BD5,"ALREADY_BLOCKED":#708794,"DO_NOT_BLOCK":#53A051}</colorPalette>
        </format>
        <format type="color" field="severity">
          <colorPalette type="map">{"critical":#B6488E,"high":#DC4E41,"medium":#F8BE34,"low":#5A9BD5,"informational":#708794}</colorPalette>
        </format>
        <drilldown>
          <condition field="VirusTotal">
            <link target="_blank">https://www.virustotal.com/gui/ip-address/$row.src|n$</link>
          </condition>
          <condition>
            <!-- click = select / unselect this IP; Ticket is filled from the finding's ITHM note -->
            <set token="d_sel">$d_sel$,$row.src$,</set>
            <eval token="form.d_tk">if(isnull('form.d_tk') OR 'form.d_tk'=="-" OR 'form.d_tk'=="", 'row.incident_no', 'form.d_tk')</eval>
          </condition>
        </drilldown>
      </table>
    </panel>
  </row>
</form>
