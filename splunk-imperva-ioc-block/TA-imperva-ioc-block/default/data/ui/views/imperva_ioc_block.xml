<form version="1.1" theme="dark" hideFilters="false">
  <label>Imperva WAF - Block Malicious IP IOCs</label>
  <description>1) Click an IOC row (or type IPs)  2) Choose action / mode  3) Tick "I confirm"  4) Press Submit. Default mode is Dry-run (preview only).</description>

  <!-- Searches only run when the Submit button is pressed -->
  <fieldset submitButton="true" autoRun="false">
    <input type="text" token="ip_list" searchWhenChanged="false">
      <label>IP / CIDR (comma separated)</label>
      <default></default>
    </input>
    <input type="dropdown" token="action" searchWhenChanged="false">
      <label>Action</label>
      <choice value="block">Block</choice>
      <choice value="unblock">Unblock</choice>
      <default>block</default>
    </input>
    <input type="radio" token="dry_run" searchWhenChanged="false">
      <label>Mode</label>
      <choice value="true">Dry-run (preview)</choice>
      <choice value="false">Apply to Imperva</choice>
      <default>true</default>
    </input>
    <input type="text" token="reason" searchWhenChanged="false">
      <label>Reason / Ticket</label>
      <default>Manual IOC block from Splunk</default>
    </input>
    <input type="checkbox" token="confirm" searchWhenChanged="false">
      <label>Confirmation</label>
      <choice value="yes">I confirm</choice>
    </input>
  </fieldset>

  <row>
    <panel>
      <title>Attacking IPs from Imperva WAF logs (last 24h, count &gt; 300) - click a row to select the IP</title>
      <!-- Base search: Imperva attack events grouped by source IP -->
      <search id="attack_ips">
        <query><![CDATA[index=imperva sourcetype="incapsula:cef" category!=normal act!=allowed
| lookup geo_attr_countries iso2 AS ccode OUTPUT country
| fillnull value="-" src act category country clapp eventtype dproc cs2Label http_method dest_ip dest_name dest_port
| stats values(fileId) AS SessionID values(clapp) AS clapp values(act) AS act values(category) AS category values(country) AS country values(eventtype) AS eventtype values(dproc) AS dproc values(cs2Label) AS cs2Label values(http_method) AS http_method values(dest_ip) AS dest_ip values(dest_name) AS dest_name values(dest_port) AS dest_port count BY src
| where count > 300
| eval msg="Attack_IP=".src.", Attack_Country=".mvjoin(country,", ").", WAF_Action=".mvjoin(act,", ").", Category=".mvjoin(category,", ")]]></query>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </search>
      <table>
        <search base="attack_ips">
          <query>| table src count country act category clapp http_method dest_name dest_port msg
| sort - count</query>
        </search>
        <option name="count">10</option>
        <option name="drilldown">row</option>
        <drilldown>
          <!-- Puts the IP in the text box. The user still has to tick "I confirm" and press Submit -->
          <set token="form.ip_list">$row.src$</set>
          <set token="form.reason">Imperva attack: $row.msg$</set>
          <unset token="form.confirm"></unset>
        </drilldown>
      </table>
    </panel>
    <panel>
      <title>Select ALL attacking IPs (click)</title>
      <table>
        <search base="attack_ips">
          <query>| where src!="-"
| stats count AS total_ips values(src) AS ips
| eval ips=mvjoin(ips, ",")
| table total_ips ips</query>
        </search>
        <option name="count">1</option>
        <option name="drilldown">row</option>
        <drilldown>
          <!-- Puts every IP in the text box (limited by max_ips_per_action in imperva.conf) -->
          <set token="form.ip_list">$row.ips$</set>
          <set token="form.reason">Imperva attack IPs count&gt;300 (bulk)</set>
          <unset token="form.confirm"></unset>
        </drilldown>
      </table>
    </panel>
  </row>

  <row>
    <panel depends="$confirm$">
      <title>Result: $action$ $ip_list$ (dry_run=$dry_run$)</title>
      <table>
        <search>
          <!-- $confirm$ is referenced so this search is NOT dispatched until "I confirm" is ticked -->
          <query>| makeresults
| eval confirmed=$confirm|s$
| impervablock action=$action|s$ ip=$ip_list|s$ dry_run=$dry_run|s$ reason=$reason|s$
| table _time ip site_id action status detail dry_run user reason</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
          <done>
            <!-- force re-confirmation for the next click -->
            <unset token="form.confirm"></unset>
          </done>
        </search>
        <option name="count">50</option>
        <option name="drilldown">none</option>
        <format type="color" field="status">
          <colorPalette type="map">{"blocked":#DC4E41,"unblocked":#53A051,"would_be_blocked":#F8BE34,"would_be_unblocked":#F8BE34,"no_change":#708794,"rejected":#AF575A,"error":#B6488E}</colorPalette>
        </format>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Audit log - who blocked what</title>
      <table>
        <search>
          <query>index=_internal source=*imperva_ioc_block.log
| table _time user action ip site_id status dry_run reason detail
| sort - _time</query>
          <earliest>-7d@d</earliest>
          <latest>now</latest>
          <refresh>60s</refresh>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
</form>
