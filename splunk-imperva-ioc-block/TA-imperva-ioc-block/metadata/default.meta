[]
access = read : [ * ], write : [ admin ]
export = none

# Only admin / imperva_blocker may run the command that changes the WAF
[commands/impervablock]
access = read : [ admin, imperva_blocker ], write : [ admin ]
export = system

[views/imperva_ioc_block]
access = read : [ admin, imperva_blocker ], write : [ admin ]

[passwords]
access = read : [ admin, imperva_blocker ], write : [ admin ]

[imperva]
access = read : [ admin, imperva_blocker ], write : [ admin ]

[commands/vtcheck]
access = read : [ admin, imperva_blocker ], write : [ admin ]
export = system

[commands/impervalist]
access = read : [ admin, imperva_blocker ], write : [ admin ]
export = system

# KV store registry: analysts must be able to write descriptions
# export = system: usable from any app (Search, ES, other dashboards); still only admin/imperva_blocker
[collections/imperva_block_registry]
access = read : [ admin, imperva_blocker ], write : [ admin, imperva_blocker ]
export = system

[transforms/imperva_block_registry]
access = read : [ admin, imperva_blocker ], write : [ admin, imperva_blocker ]
export = system

[commands/impervaexclude]
access = read : [ admin, imperva_blocker ], write : [ admin ]
export = system

[collections/imperva_exclude_list]
access = read : [ admin, imperva_blocker ], write : [ admin, imperva_blocker ]
export = system

[transforms/imperva_exclude_list]
access = read : [ admin, imperva_blocker ], write : [ admin, imperva_blocker ]
export = system

[macros/imperva_ioc_notables]
access = read : [ admin, imperva_blocker ], write : [ admin ]
