<form version="1.1" theme="dark" hideFilters="true">
  <label>Imperva IOC Block V2 – Auto unblock</label>
  <description>IP rules of every enabled WAF policy are unblocked automatically when the IP sent no request: cloud provider IPs (AWS, Google Cloud, Azure ...) and shared IPs (mobile carriers) after 7 days, other IPs after 60 days. The countdown starts at the latest of the last attack (Imperva "Blocked IP" log), the block date and the day V2 first saw the rule. Runs every day at 02:17 ("Imperva V2 - Auto unblock (daily)"). Every action is written to the audit log.</description>
  <init>
    <set token="a_refresh">init</set>
  </init>


  <search id="plan">
    <query>| makeresults | impervaautounblock action=list
| eval _r=$a_refresh|s$</query>
    <earliest>-1m</earliest>
    <latest>now</latest>
    <refresh>300s</refresh>
    <refreshType>delay</refreshType>
  </search>
  <row>
    <panel>
      <single>
        <title>Blocked IP rules</title>
        <search base="plan">
          <query>| stats count</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x5A9BD5","0x5A9BD5"]</option>
        <option name="useColors">1</option>
        <option name="underLabel">all policies</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Attacking now</title>
        <search base="plan">
          <query>| where status_code="attacking" | stats count</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0xDC4E41","0xDC4E41"]</option>
        <option name="useColors">1</option>
        <option name="underLabel">blocked IPs with a request in the last 24 h</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Attacks in the last 24 h</title>
        <search base="plan">
          <query>| stats sum(attacks_24h) AS attacks</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0xDC4E41","0xDC4E41"]</option>
        <option name="useColors">1</option>
        <option name="underLabel">requests the WAF blocked from blocked IPs</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Due now</title>
        <search base="plan">
          <query>| where status_code="due" | stats count</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x5A9BD5","0x5A9BD5"]</option>
        <option name="useColors">1</option>
        <option name="underLabel">unblocked at the next run (02:17)</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Kept</title>
        <search base="plan">
          <query>| where status_code="kept" | stats count</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53A051","0x53A051"]</option>
        <option name="useColors">1</option>
        <option name="underLabel">never unblocked</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Cloud / shared IPs</title>
        <search base="plan">
          <query>| where short_block!="-" | stats count</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0xF8BE34","0xF8BE34"]</option>
        <option name="useColors">1</option>
        <option name="underLabel">short block (7 days quiet)</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <html>
        <div style="display:flex;flex-wrap:wrap;gap:8px 22px;align-items:center;padding:4px 2px;font-size:13px;line-height:1.5">
          <span style="background:#53A051;color:#fff;border-radius:3px;padding:2px 8px;font-weight:600">⏱ AUTO UNBLOCK ON</span>
          <span>☁ Cloud provider / shared IP: <b>7 days</b> without an attack</span>
          <span>Other IPs: <b>60 days</b> without an attack</span>
          <span>All enabled WAF policies</span>
          <span>Max <b>50</b> IP rules per run (the rest the next day)</span>
          <span style="opacity:.75">Every day at 02:17 · fixed values, no settings</span>
        </div>
      </html>
    </panel>
  </row>

  <row>
    <panel>
      <title>Run now – unblock what is due (same as the daily run)</title>
      <table>
        <search base="plan">
          <query>| stats count(eval(status_code="due")) AS due
| eval Run=if(due>0, "▶ RUN NOW (".due." due)", "Nothing due now"), note=if(due>50, "50 per run - the rest at the next run", "-")
| table Run due note</query>
        </search>
        <option name="count">1</option>
        <option name="drilldown">cell</option>
        <format type="color" field="Run">
          <colorPalette type="expression">if(like(value, "▶%"), "#53A051", "#3C444D")</colorPalette>
        </format>
        <drilldown>
          <condition field="Run">
            <set token="a_run">$row.Run$</set>
          </condition>
          <condition></condition>
        </drilldown>
      </table>
    </panel>
  </row>
  <row>
    <panel depends="$a_run$">
      <title>Auto unblock result – written to the audit log (click a row to close)</title>
      <table>
        <search>
          <query>| makeresults | impervaautounblock action=run
| eval _r=$a_run|s$
| `imperva_audit_write`
| table time ip action status verified policy ticket description detail</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
          <done>
            <set token="a_refresh">$job.sid$</set>
          </done>
        </search>
        <option name="count">50</option>
        <option name="wrap">true</option>
        <option name="drilldown">cell</option>
        <format type="color" field="status">
          <colorPalette type="map">{"blocked":#DC4E41,"unblocked":#53A051,"no_change":#708794,"rejected":#AF575A,"error":#B6488E,"dismissed":#5C6773,"restored":#5A9BD5}</colorPalette>
        </format>
        <format type="color" field="verified">
          <colorPalette type="map">{"yes":#53A051,"no":#DC4E41,"unknown":#F8BE34}</colorPalette>
        </format>
        <drilldown>
          <unset token="a_run"></unset>
        </drilldown>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>IP rules on the WAF – all policies (📌 Keep = never unblock · ↺ Default · 🔓 Unblock now)</title>
      <input type="dropdown" token="a_f" searchWhenChanged="true">
        <label>Show</label>
        <choice value="all">All</choice>
        <choice value="due">Due</choice>
        <choice value="attacking">Attacking now</choice>
        <choice value="soon">Unblock soon</choice>
        <choice value="kept">Kept</choice>
        <choice value="cloud">Cloud / shared IPs</choice>
        <choice value="own">Own policy</choice>
        <choice value="other">Other policies</choice>
        <default>all</default>
      </input>
      <input type="text" token="a_q" searchWhenChanged="true">
        <label>🔎 Search IP / policy / ticket (* = all)</label>
        <default>*</default>
      </input>
      <input type="text" token="a_reason" searchWhenChanged="true">
        <label>Reason for Keep / Default / Unblock now ("-" if none)</label>
        <default>-</default>
      </input>
      <table>
        <search base="plan">
          <query>| eval _f=$a_f|s$, _q=lower(trim(replace($a_q|s$, "[*]", "")))
| where _f="all" OR status_code=_f OR (_f="cloud" AND short_block!="-") OR (_f="own" AND own_policy="yes") OR (_f="other" AND own_policy="no")
| where _q="" OR like(lower(ip." ".policy_id." ".policy_name." ".ticket." ".description." ".owner), "%"._q."%")
| eval Keep=if(status_code="kept", "-", "📌 Keep"), Default=if(rule_reason!="-" OR status_code="kept", "↺ Default", "-"), Unblock="🔓 Unblock now"
| table Keep Default Unblock ip status last_attack attacks_24h unblock_after unblock_on days_left short_block owner policy_id policy_name blocked_at listed_since ticket description rule_reason
| rename last_attack AS "Last attack", attacks_24h AS "Attacks 24h", unblock_after AS "Unblock after", unblock_on AS "Unblock on", days_left AS "Days left", short_block AS "Cloud / shared", policy_id AS policy, listed_since AS "Watched since", rule_reason AS "Rule reason"</query>
        </search>
        <option name="count">25</option>
        <option name="wrap">true</option>
        <option name="drilldown">cell</option>
        <format type="color" field="status">
          <colorPalette type="expression">case(like(value,"Due · unblock%"),"#5A9BD5", like(value,"Due%"),"#708794", like(value,"Attacking%"),"#DC4E41", like(value,"Unblock soon%"),"#F8BE34", like(value,"Kept%"),"#53A051", true(),"#3C444D")</colorPalette>
        </format>
        <format type="color" field="Keep">
          <colorPalette type="expression">if(like(value, "📌%"), "#53A051", "#3C444D")</colorPalette>
        </format>
        <format type="color" field="Default">
          <colorPalette type="expression">if(like(value, "↺%"), "#1F6F8B", "#3C444D")</colorPalette>
        </format>
        <format type="color" field="Unblock">
          <colorPalette type="expression">"#DC4E41"</colorPalette>
        </format>
        <drilldown>
          <condition field="Keep">
            <set token="a_set_rule">keep</set>
            <set token="a_set_pid">$row.policy$</set>
            <set token="a_set_ip">$row.ip$</set>
          </condition>
          <condition field="Default">
            <set token="a_set_rule">default</set>
            <set token="a_set_pid">$row.policy$</set>
            <set token="a_set_ip">$row.ip$</set>
          </condition>
          <condition field="Unblock">
            <set token="a_unb_pid">$row.policy$</set>
            <set token="a_unb_ip">$row.ip$</set>
          </condition>
          <condition></condition>
        </drilldown>
      </table>
    </panel>
  </row>
  <row>
    <panel depends="$a_set_ip$">
      <title>Unblock rule saved (click to close)</title>
      <table>
        <search>
          <query>| makeresults | impervaautounblock action=set ip=$a_set_ip|s$ policy_id=$a_set_pid|s$ rule=$a_set_rule|s$ reason=$a_reason|s$
| `imperva_audit_write`
| table time ip policy action status detail description</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
          <done>
            <set token="a_refresh">$job.sid$</set>
          </done>
        </search>
        <option name="count">10</option>
        <option name="drilldown">cell</option>
        <format type="color" field="status">
          <colorPalette type="map">{"blocked":#DC4E41,"unblocked":#53A051,"no_change":#708794,"rejected":#AF575A,"error":#B6488E,"dismissed":#5C6773,"restored":#5A9BD5}</colorPalette>
        </format>
        <format type="color" field="verified">
          <colorPalette type="map">{"yes":#53A051,"no":#DC4E41,"unknown":#F8BE34}</colorPalette>
        </format>
        <drilldown>
          <unset token="a_set_ip"></unset>
        </drilldown>
      </table>
    </panel>
  </row>
  <row>
    <panel depends="$a_unb_ip$">
      <title>Unblock now – result (written to the audit log; the list updates after the next policy refresh, 5 min) · click to close</title>
      <table>
        <search>
          <query>| makeresults | impervablock action=unblock ip=$a_unb_ip|s$ policy_id=$a_unb_pid|s$ description=$a_reason|s$
| `imperva_audit_write`
| table time ip policy action status verified backend soar_container detail</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
          <done>
            <set token="a_refresh">$job.sid$</set>
          </done>
        </search>
        <option name="count">10</option>
        <option name="wrap">true</option>
        <option name="drilldown">cell</option>
        <format type="color" field="status">
          <colorPalette type="map">{"blocked":#DC4E41,"unblocked":#53A051,"no_change":#708794,"rejected":#AF575A,"error":#B6488E,"dismissed":#5C6773,"restored":#5A9BD5}</colorPalette>
        </format>
        <format type="color" field="verified">
          <colorPalette type="map">{"yes":#53A051,"no":#DC4E41,"unknown":#F8BE34}</colorPalette>
        </format>
        <drilldown>
          <unset token="a_unb_ip"></unset>
        </drilldown>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Policies with BLOCK IP rules – their IDs must be in IMPERVA_POLICY_IDS on SOAR</title>
      <table>
        <search>
          <query>| makeresults | impervaautounblock action=policies
| eval _r=$a_refresh|s$
| table policy_id policy_name own_policy block_ip_rules cloud shared due attacks_24h</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
    <panel>
      <title>Auto unblock log – last 30 days (audit log)</title>
      <table>
        <search>
          <query>| inputlookup imperva_audit
| eval _t=tonumber(time)
| where _t&gt;=relative_time(now(), "-30d@d") AND (user="auto-unblock" OR like(action, "auto_unblock%"))
| sort 0 - _t
| eval time=strftime(_t, "%Y-%m-%d %H:%M"), ticket=replace(coalesce(ticket, "-"), "(?i)ITHM\s*-?\s*", "")
| table time user action ip policy status description detail</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
          <refresh>300s</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="count">20</option>
        <option name="wrap">true</option>
        <option name="drilldown">none</option>
        <format type="color" field="status">
          <colorPalette type="map">{"blocked":#DC4E41,"unblocked":#53A051,"no_change":#708794,"rejected":#AF575A,"error":#B6488E,"dismissed":#5C6773,"restored":#5A9BD5}</colorPalette>
        </format>
        <format type="color" field="verified">
          <colorPalette type="map">{"yes":#53A051,"no":#DC4E41,"unknown":#F8BE34}</colorPalette>
        </format>
      </table>
    </panel>
  </row>
</form>
